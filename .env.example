# Valentine — environment variables
#
# Copy to `.env` and fill in. Bun auto-loads `.env`; under plain node/npx,
# export these or load with a dotenv tool. Config precedence: values in
# ~/.valentine/config.json win, env fills only what's unset (src/config.ts).
# Choices (which CRM, which provider) live in config.json — set them with
# `valentine init` (add -y --crm … --provider … for headless). Env carries
# the secrets. Everything here is read-only — Valentine never writes to your CRM.

# ─── Model provider ──────────────────────────────────────────────────────────
# Anthropic API key. Required when provider is "anthropic" (the default).
ANTHROPIC_API_KEY=sk-ant-...

# Override the model. Anthropic default: claude-haiku-4-5 (near-zero cost);
# sharper: claude-sonnet-4-6 (~10×). For Ollama: a tool-calling model
# (llama3.1, qwen2.5, mistral-nemo…).
# VALENTINE_MODEL=claude-haiku-4-5

# Local / Ollama (provider "ollama" — no API key, nothing leaves your machine).
# Default host if unset: http://127.0.0.1:11434. VALENTINE_OLLAMA_HOST wins
# over OLLAMA_HOST if both are set.
# OLLAMA_HOST=http://127.0.0.1:11434

# ─── CRM connector (set exactly ONE) ─────────────────────────────────────────
# Attio — read-only access token (Settings → Developers → API keys).
VALENTINE_ATTIO_KEY=

# Affinity — read-only API key. Use this INSTEAD of the Attio key.
VALENTINE_AFFINITY_KEY=

# Salesforce — REST access token + instance URL. Use a read-only user's token
# (connected app, or locally: `sf org display --json`). Tokens expire with the
# Salesforce session. Both variables are required together.
VALENTINE_SALESFORCE_KEY=
VALENTINE_SALESFORCE_INSTANCE_URL=

# ─── Slack slash command (`valentine slack`) ─────────────────────────────────
# Signing secret from your Slack app (Basic Information → Signing Secret).
# No bot token needed — replies go through Slack's response_url, ephemeral,
# only to whoever ran /valentine.
VALENTINE_SLACK_SIGNING_SECRET=

# Port the slash-command server listens on (or --port). Default: 3141.
# VALENTINE_SLACK_PORT=3141

# ─── Roadmap: not yet wired ──────────────────────────────────────────────────
# Placeholders for services named in the showcase but not implemented yet.
# Uncomment once the corresponding connector/provider lands — no-ops today.

# HubSpot connector (roadmap — one file away)
# VALENTINE_HUBSPOT_KEY=

# AWS Bedrock provider (listed in `valentine init`, disabled until wired)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Calendar `valentine watch` (roadmap P1) — path to an .ics or calendar creds
# VALENTINE_CALENDAR_ICS=
